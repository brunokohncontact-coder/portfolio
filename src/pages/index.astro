  'Design',
  'Estratégia',
  'Motion',
  'UX / UI',
  'Automação',
  'Identidade Visual',
  'Editorial',
  'Audiovisual',
];

const pilares = [
  {
    title: 'Estratégia de Comunicação Digital',
    desc: 'Planejamento editorial, social media, análise de métricas e construção de identidade institucional. Comunicação que começa pelo objetivo e pelo público, antes de qualquer execução.',
