      if ((e.target as HTMLElement).tagName === 'INPUT') return;
      if (e.key.length !== 1) return;
      keyBuffer.push(e.key.toLowerCase());
      if (keyBuffer.length > 6) keyBuffer.shift();
      const seq = keyBuffer.join('');
      for (const code in easterCodes) {
        if (seq.endsWith(code)) {
          easterCodes[code]();
          keyBuffer.length = 0;
          break;
        }
      }
    });

    // ─── WEBGL SHADER BACKGROUND (dark numeros section) ────────
    (async () => {
      const noiseCanvas = document.getElementById('numeros-noise') as HTMLCanvasElement | null;
      if (!noiseCanvas) return;
      const THREE = await import('three');

      const noiseRenderer = new THREE.WebGLRenderer({ canvas: noiseCanvas, alpha: true, antialias: false });
      noiseRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      const noiseScene = new THREE.Scene();
      const noiseCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

      const noiseShader = new THREE.ShaderMaterial({
        uniforms: {
          uTime: { value: 0 },
          uMouse: { value: new THREE.Vector2(0.5, 0.5) },
          uRes: { value: new THREE.Vector2(1, 1) },
          uAccent: { value: new THREE.Color('#5D4FA8') },
        },
        vertexShader: `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          varying vec2 vUv;
          uniform float uTime;
          uniform vec2 uMouse;
          uniform vec2 uRes;
          uniform vec3 uAccent;

          // 2D simplex-like noise
          vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
          vec2 mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
          vec3 permute(vec3 x) { return mod289(((x*34.0)+1.0)*x); }

          float snoise(vec2 v) {
            const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
            vec2 i  = floor(v + dot(v, C.yy));
            vec2 x0 = v - i + dot(i, C.xx);
            vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
            vec4 x12 = x0.xyxy + C.xxzz;
            x12.xy -= i1;
            i = mod289(i);
            vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
            vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
            m = m*m; m = m*m;
            vec3 x = 2.0 * fract(p * C.www) - 1.0;
            vec3 h = abs(x) - 0.5;
            vec3 ox = floor(x + 0.5);
            vec3 a0 = x - ox;
            m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
            vec3 g;
            g.x = a0.x * x0.x + h.x * x0.y;
            g.yz = a0.yz * x12.xz + h.yz * x12.yw;
            return 130.0 * dot(m, g);
          }

          void main() {
            vec2 uv = vUv;
            vec2 aspect = vec2(uRes.x / uRes.y, 1.0);
            vec2 p = uv * aspect;

            float n1 = snoise(p * 2.0 + uTime * 0.05);
            float n2 = snoise(p * 4.0 - uTime * 0.07);
            float n3 = snoise(p * 8.0 + uTime * 0.03);
            float n = n1 * 0.5 + n2 * 0.3 + n3 * 0.2;

            float dist = distance(uv, uMouse);
            float spot = smoothstep(0.4, 0.0, dist) * 0.4;

            vec3 col = mix(vec3(0.04, 0.04, 0.06), uAccent * 0.5, smoothstep(-0.3, 0.6, n) + spot);
            float alpha = 0.35 + spot * 0.4;
            gl_FragColor = vec4(col, alpha);
          }
        `,
        transparent: true,
      });

      const plane = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), noiseShader);
      noiseScene.add(plane);

      const resizeNoise = () => {
        const w = window.innerWidth;
        const h = window.innerHeight;
        noiseRenderer.setSize(w, h, false);
        noiseShader.uniforms.uRes.value.set(w, h);
      };
      resizeNoise();
      window.addEventListener('resize', resizeNoise);

      onMouseMove((e) => {
        noiseShader.uniforms.uMouse.value.set(e.clientX / window.innerWidth, 1 - e.clientY / window.innerHeight);
      });

      const noiseStart = performance.now();
      const noiseLoop = () => {
        if (pageActive && document.body.classList.contains('in-numeros')) {
          noiseShader.uniforms.uTime.value = (performance.now() - noiseStart) / 1000;
          noiseRenderer.render(noiseScene, noiseCam);
        }
        requestAnimationFrame(noiseLoop);
      };
      requestAnimationFrame(noiseLoop);
    })();

    // ─── 3D BOOK MOCKUP (project 02) ──────────────────────────
    (async () => {
      const bookHosts = document.querySelectorAll<HTMLElement>('[data-book]');
      if (bookHosts.length === 0) return;
      const THREE = await import('three');

      bookHosts.forEach((host) => {
        const imgSrc = host.dataset.book;
        if (!imgSrc) return;
        const img = host.querySelector('img');
        if (!img) return;

        // Replace image with canvas mount
        const wrap = document.createElement('div');
        wrap.className = 'book-canvas-wrap';
        const canvas = document.createElement('canvas');
        canvas.className = 'book-canvas';
        wrap.appendChild(canvas);
        host.appendChild(wrap);
        img.style.display = 'none';

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
        camera.position.z = 5.5;

        const light = new THREE.DirectionalLight(0xffffff, 1.2);
        light.position.set(2, 3, 4);
        scene.add(light);
        scene.add(new THREE.AmbientLight(0xffffff, 0.7));

        const bookW = 2.2;
        const bookH = 3;
        const bookD = 0.45;
        const faceAspect = bookW / bookH;

        const loader = new THREE.TextureLoader();
        const cover = loader.load(imgSrc, (tex) => {
          const img = tex.image as HTMLImageElement;
          const imgAspect = img.width / img.height;
          // Crop to fit (CSS object-fit: cover behavior)
          if (imgAspect > faceAspect) {
            tex.repeat.x = faceAspect / imgAspect;
            tex.offset.x = (1 - tex.repeat.x) / 2;
          } else {
            tex.repeat.y = imgAspect / faceAspect;
            tex.offset.y = (1 - tex.repeat.y) / 2;
          }
          tex.needsUpdate = true;
          renderer.render(scene, camera);
        });
        cover.colorSpace = THREE.SRGBColorSpace;

        const bookGeo = new THREE.BoxGeometry(bookW, bookH, bookD);
        const sideMat = new THREE.MeshStandardMaterial({ color: 0xf5f3ef, roughness: 0.85 });
        const spineMat = new THREE.MeshStandardMaterial({ color: 0x2a2a2c, roughness: 0.7 });
        const coverMat = new THREE.MeshStandardMaterial({ map: cover, roughness: 0.55 });
        const backMat = new THREE.MeshStandardMaterial({ color: 0xeeeae3, roughness: 0.85 });

        // box face order: [+x, -x, +y, -y, +z, -z]
        const book = new THREE.Mesh(bookGeo, [spineMat, sideMat, sideMat, sideMat, coverMat, backMat]);
        book.rotation.y = -0.4;
        book.rotation.x = 0.1;
        scene.add(book);

        let targetY = -0.4, targetX = 0.1;
        let curY = -0.4, curX = 0.1;
        let dragging = false;
        let lastMX = 0, lastMY = 0;

        const resize = () => {
          const w = host.offsetWidth;
          const h = host.offsetHeight;
          renderer.setSize(w, h, false);
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        };
        resize();
        const ro = new ResizeObserver(resize);
        ro.observe(host);

        host.addEventListener('mousemove', (e) => {
          if (dragging) return;
          const rect = host.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          targetY = -0.4 + x * 1.6;
          targetX = 0.1 + y * -0.8;
        });

        host.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          dragging = true;
          lastMX = e.clientX; lastMY = e.clientY;
          wrap.classList.add('is-grabbing');
          host.setPointerCapture(e.pointerId);
        });
        window.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const dx = e.clientX - lastMX;
          const dy = e.clientY - lastMY;
          targetY += dx * 0.01;
          targetX -= dy * 0.01;
          lastMX = e.clientX; lastMY = e.clientY;
        });
        const bookEnd = () => {
          dragging = false;
          wrap.classList.remove('is-grabbing');
        };
        window.addEventListener('pointerup', bookEnd);
        window.addEventListener('pointercancel', bookEnd);

        const bookVisible = observeVisibility(host);
        const loop = () => {
          if (!pageActive || !bookVisible.current) {
            requestAnimationFrame(loop);
            return;
          }
          curY += (targetY - curY) * 0.08;
          curX += (targetX - curX) * 0.08;
          book.rotation.y = curY;
          book.rotation.x = curX;
          renderer.render(scene, camera);
          requestAnimationFrame(loop);
        };
        loop();
      });
    })();

    // ─── CURSOR PET (creature com personalidade) ─────────────
    const cursorPet = document.getElementById('cursor-pet');
    const petBubble = document.getElementById('cursor-pet-bubble');
    const petPupils = cursorPet?.querySelectorAll<HTMLElement>('.cursor-pet-pupil');

    if (cursorPet && isDesktop) {
      let petX = 0, petY = 0;
      let petTargetX = window.innerWidth / 2, petTargetY = window.innerHeight / 2;
      let lastMoveTime = performance.now();
      let lastMouseX = 0, lastMouseY = 0;
      let petState: 'follow' | 'idle' | 'sleepy' | 'excited' | 'surprised' | 'hidden' = 'follow';
      let nextBubbleAt = performance.now() + 7000 + Math.random() * 8000;

      const phrases = ['oi', '✦', 'hmm', '👀', 'olá', 'oi!', '✺', '◡'];
      const phrasesIdle = ['zzz', '...', '◠ ◠'];
      const phrasesExcited = ['!', '✨', 'oo!', '◉‿◉'];

      const showBubble = (msg: string, duration = 1800) => {
        if (!petBubble) return;
        petBubble.textContent = msg;
        petBubble.classList.add('is-visible');
        setTimeout(() => petBubble.classList.remove('is-visible'), duration);
      };

      const setState = (s: typeof petState) => {
        if (petState !== s) {
          const prev = petState;
          petState = s;
          cursorPet.dataset.state = s;
          // Speech bubble on state transition
          if (s === 'sleepy' && prev !== 'sleepy') {
            showBubble(phrasesIdle[Math.floor(Math.random() * phrasesIdle.length)], 2500);
          }
          if (s === 'excited' && prev !== 'excited') {
            if (Math.random() < 0.3) showBubble(phrasesExcited[Math.floor(Math.random() * phrasesExcited.length)], 1200);
          }
        }
      };

      onMouseMove((e) => {
        petTargetX = e.clientX - 55;
        petTargetY = e.clientY + 55;
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
        lastMoveTime = performance.now();
      });

      const petTick = () => {
        if (!pageActive) {
          requestAnimationFrame(petTick);
          return;
        }
        petX += (petTargetX - petX) * 0.06;
        petY += (petTargetY - petY) * 0.06;
        cursorPet.style.transform = `translate(${petX}px, ${petY}px)`;
        cursorPet.style.setProperty('--px', `${petX}px`);
        cursorPet.style.setProperty('--py', `${petY}px`);

        // Pupils track the cursor
        if (petPupils && petPupils.length === 2 && petState !== 'sleepy') {
          const petRect = cursorPet.getBoundingClientRect();
          const petCx = petRect.left + petRect.width / 2;
          const petCy = petRect.top + petRect.height / 2;
          const angle = Math.atan2(lastMouseY - petCy, lastMouseX - petCx);
          const dist = Math.min(2.2, Math.hypot(lastMouseX - petCx, lastMouseY - petCy) / 25);
          const dx = Math.cos(angle) * dist;
          const dy = Math.sin(angle) * dist;
          petPupils.forEach(p => { p.style.transform = `translate(${dx}px, ${dy}px)`; });
        }

        // State machine
        const idleTime = performance.now() - lastMoveTime;
        if (petState !== 'excited' && petState !== 'surprised' && petState !== 'hidden') {
          if (idleTime > 6000) setState('sleepy');
          else if (idleTime > 2500) setState('idle');
          else setState('follow');
        }

        // Random speech bubble while following
        if (performance.now() > nextBubbleAt && petState === 'follow' && !document.body.classList.contains('menu-open')) {
          if (Math.random() < 0.6) {
            showBubble(phrases[Math.floor(Math.random() * phrases.length)], 1600);
          }
          nextBubbleAt = performance.now() + 12000 + Math.random() * 15000;
        }

        requestAnimationFrame(petTick);
      };
      requestAnimationFrame(petTick);

      // React to interactive elements
      let excitedTimeout: number | undefined;
      document.addEventListener('mouseover', (e) => {
        const t = (e.target as HTMLElement)?.closest('a, button, [data-cursor]');
        if (t) {
          setState('excited');
          lastMoveTime = performance.now();
          clearTimeout(excitedTimeout);
          excitedTimeout = window.setTimeout(() => {
            if (petState === 'excited') setState('follow');
          }, 800);
        }
      });

      // Bounce + surprised on click
      document.addEventListener('mousedown', (e) => {
        const target = (e.target as HTMLElement);
        if (target.closest('input, textarea')) return;
        cursorPet.classList.add('is-bouncing');
        setState('surprised');
        setTimeout(() => cursorPet.classList.remove('is-bouncing'), 500);
        setTimeout(() => setState('follow'), 600);
      });

      // Hide near edges
      onMouseMove((e) => {
        const margin = 40;
        const isEdge = e.clientX < margin || e.clientX > window.innerWidth - margin ||
                       e.clientY < margin || e.clientY > window.innerHeight - margin;
        if (isEdge) setState('hidden');
        else if (petState === 'hidden') setState('follow');
      });

      // Greeting on first load
      setTimeout(() => showBubble('oi! ✦', 2200), 2200);
    }

    // ─── VORONOI PATTERN BACKGROUND ─────────────────────────
    const voronoiCanvas = document.getElementById('voronoi-canvas') as HTMLCanvasElement | null;
    if (voronoiCanvas) {
      const vctx = voronoiCanvas.getContext('2d');
      const dprV = window.devicePixelRatio || 1;
      let cells: { x: number; y: number; vx: number; vy: number }[] = [];

      const resizeVoronoi = () => {
        voronoiCanvas.width = window.innerWidth * dprV;
        voronoiCanvas.height = window.innerHeight * dprV;
        voronoiCanvas.style.width = window.innerWidth + 'px';
        voronoiCanvas.style.height = window.innerHeight + 'px';
        cells = [];
        const count = 32;
        for (let i = 0; i < count; i++) {
          cells.push({
            x: Math.random() * voronoiCanvas.width,
            y: Math.random() * voronoiCanvas.height,
            vx: (Math.random() - 0.5) * 0.3,
            vy: (Math.random() - 0.5) * 0.3,
          });
        }
      };
      resizeVoronoi();
      window.addEventListener('resize', resizeVoronoi);

      let vMouseX = -9999, vMouseY = -9999;
      onMouseMove((e) => {
        vMouseX = e.clientX * dprV;
        vMouseY = e.clientY * dprV;
      });

      const drawVoronoi = () => {
        if (!vctx || !pageActive) {
          requestAnimationFrame(drawVoronoi);
          return;
        }
        // Move cells slowly
        cells.forEach((c) => {
          c.x += c.vx; c.y += c.vy;
          if (c.x < 0 || c.x > voronoiCanvas.width) c.vx *= -1;
          if (c.y < 0 || c.y > voronoiCanvas.height) c.vy *= -1;
        });

        // Render using cell-anchored polygon approximation via grid sampling
        const cellSize = 24 * dprV;
        vctx.clearRect(0, 0, voronoiCanvas.width, voronoiCanvas.height);
        const isDark = document.body.classList.contains('theme-dark');
        const baseColor = isDark ? 'rgba(255, 255, 255,' : 'rgba(93, 79, 168,';

        for (let y = 0; y < voronoiCanvas.height; y += cellSize) {
          for (let x = 0; x < voronoiCanvas.width; x += cellSize) {
            let minD = Infinity, secondD = Infinity;
            for (const c of cells) {
              const d = (c.x - x) ** 2 + (c.y - y) ** 2;
              if (d < minD) { secondD = minD; minD = d; }
              else if (d < secondD) secondD = d;
            }
            // Cell border heuristic
            const edge = Math.max(0, 1 - Math.abs(secondD - minD) / 6000);
            if (edge > 0.05) {
              const mouseDist = Math.hypot(x - vMouseX, y - vMouseY) / dprV;
              const boost = Math.max(0, 1 - mouseDist / 250);
              vctx.fillStyle = `${baseColor} ${edge * (0.08 + boost * 0.25)})`;
              vctx.fillRect(x, y, cellSize, cellSize);
            }
          }
        }
        requestAnimationFrame(drawVoronoi);
      };
      requestAnimationFrame(drawVoronoi);
    }

