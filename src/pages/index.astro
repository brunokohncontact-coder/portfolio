      kSpine.position.x = -0.45;
      kGroup.add(kSpine);
      // Upper diagonal arm (positioned to start where spine ends, going up-right)
      const kUp = new THREE.Mesh(new THREE.BoxGeometry(0.32, 1.5, 0.55), mat);
      kUp.position.set(0.2, 0.6, 0);
      kUp.rotation.z = -Math.PI / 4;
      kGroup.add(kUp);
      // Lower diagonal arm
      const kDown = new THREE.Mesh(new THREE.BoxGeometry(0.32, 1.5, 0.55), mat);
      kDown.position.set(0.2, -0.6, 0);
      kDown.rotation.z = Math.PI / 4;
      kGroup.add(kDown);
      kGroup.position.x = 1.5;

      group.add(bGroup);
      group.add(kGroup);
      scene.add(group);

      let targetY = 0, targetX = 0;
      let curY = 0, curX = 0;
      let dragging = false, lastX = 0, lastY = 0;

      const resize = () => {
        const w = section.offsetWidth;
        const h = section.offsetHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      window.addEventListener('resize', resize);

      section.addEventListener('mousemove', (e) => {
        if (dragging) return;
        const rect = section.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        targetY = x * 1.2;
        targetX = y * -0.6;
      });

      section.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        lastX = e.clientX;
        lastY = e.clientY;
        section.setPointerCapture(e.pointerId);
      });
      window.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        targetY += (e.clientX - lastX) * 0.01;
        targetX -= (e.clientY - lastY) * 0.01;
        lastX = e.clientX; lastY = e.clientY;
      });
      const bkEnd = () => { dragging = false; };
      window.addEventListener('pointerup', bkEnd);
      window.addEventListener('pointercancel', bkEnd);

      const clock3Start = performance.now();
      let visible = false;
      const obs = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: 0.05 });
      obs.observe(section);

      const loop = () => {
        if (visible && pageActive) {
          curY += (targetY - curY) * 0.06;
          curX += (targetX - curX) * 0.06;
          group.rotation.y = curY + Math.sin(((performance.now() - clock3Start) / 1000) * 0.3) * 0.05;
          group.rotation.x = curX;
          renderer.render(scene, camera);
        }
        requestAnimationFrame(loop);
      };
      loop();
    })();

    // ─── PHYSICS PLAYGROUND (Matter.js) ─────────────────────
    (async () => {
      const physicsCanvas = document.getElementById('physics-canvas') as HTMLCanvasElement | null;
      const physicsSection = document.getElementById('physics');
      if (!physicsCanvas || !physicsSection) return;

      const Matter = await import('matter-js');
      const { Engine, Runner, Bodies, Mouse, MouseConstraint, World, Composite } = Matter;
      type PhysicsBody = Matter.Body & { customW: number; customH: number; label: string };

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let w = physicsSection.offsetWidth;
      let h = physicsSection.offsetHeight;

      // Canvas setup (ONCE)
      const setupCanvas = () => {
        w = physicsSection.offsetWidth;
        h = physicsSection.offsetHeight;
        physicsCanvas.width = w * dpr;
        physicsCanvas.height = h * dpr;
        physicsCanvas.style.width = w + 'px';
        physicsCanvas.style.height = h + 'px';
      };
      setupCanvas();

      const ctx = physicsCanvas.getContext('2d');
      if (!ctx) return;

      const engine = Engine.create();
      engine.world.gravity.y = 0.7;

      // Walls (no render, invisible)
      const wallOpts = { isStatic: true, render: { visible: false } };
      let walls = [
        Bodies.rectangle(w / 2, h + 30, w, 60, wallOpts),
        Bodies.rectangle(-30, h / 2, 60, h, wallOpts),
        Bodies.rectangle(w + 30, h / 2, 60, h, wallOpts),
        Bodies.rectangle(w / 2, -30, w, 60, wallOpts),
      ];
      World.add(engine.world, walls);

      // Tool tags as physics bodies
      const tools = ['Photoshop', 'Illustrator', 'AE', 'Premiere', 'Figma', 'HTML', 'CSS', 'JS', 'Moodle', 'Power Automate'];
      const bodies: PhysicsBody[] = [];

      ctx.font = '500 12px "DM Sans", system-ui';
      tools.forEach((tool, i) => {
        const x = (w / (tools.length + 1)) * (i + 1);
        const y = 60 + Math.random() * 80;
        const tw = ctx.measureText(tool).width;
        const rectW = tw + 28;
        const rectH = 30;
        const body = Bodies.rectangle(x, y, rectW, rectH, {
          chamfer: { radius: 15 },
          restitution: 0.55,
          friction: 0.12,
          frictionAir: 0.012,
          density: 0.002,
        }) as PhysicsBody;
        body.label = tool;
        body.customW = rectW;
        body.customH = rectH;
        bodies.push(body);
      });
      World.add(engine.world, bodies);

      // Mouse drag
      const mouse = Mouse.create(physicsCanvas);
      mouse.pixelRatio = dpr;
      const mouseConstraint = MouseConstraint.create(engine, {
        mouse,
        constraint: {
          stiffness: 0.2,
          damping: 0.1,
          render: { visible: false },
        },
      });
      World.add(engine.world, mouseConstraint);

      // Properly create and run a Runner
      const runner = Runner.create();
      Runner.run(runner, engine);

      // Resize handler
      window.addEventListener('resize', () => {
        Composite.remove(engine.world, walls);
        setupCanvas();
        walls = [
          Bodies.rectangle(w / 2, h + 30, w, 60, wallOpts),
          Bodies.rectangle(-30, h / 2, 60, h, wallOpts),
          Bodies.rectangle(w + 30, h / 2, 60, h, wallOpts),
          Bodies.rectangle(w / 2, -30, w, 60, wallOpts),
        ];
        World.add(engine.world, walls);
      });

      // Custom render loop (draws pills with labels)
      const physicsVisible = observeVisibility(physicsSection);
      const draw = () => {
        if (!pageActive || !physicsVisible.current) {
          requestAnimationFrame(draw);
          return;
        }
        // Reset transform and clear (no resize per frame)
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);

        bodies.forEach((body) => {
          const rectW = body.customW;
          const rectH = body.customH;
          ctx.save();
          ctx.translate(body.position.x, body.position.y);
          ctx.rotate(body.angle);
          // Pill
          ctx.fillStyle = '#FFFFFF';
          ctx.strokeStyle = '#D5D5D8';
          ctx.lineWidth = 1;
          ctx.beginPath();
          if (ctx.roundRect) {
            ctx.roundRect(-rectW / 2, -rectH / 2, rectW, rectH, rectH / 2);
          } else {
            // Fallback for older browsers
            const r = rectH / 2;
            ctx.moveTo(-rectW / 2 + r, -rectH / 2);
            ctx.arcTo(rectW / 2, -rectH / 2, rectW / 2, rectH / 2, r);
            ctx.arcTo(rectW / 2, rectH / 2, -rectW / 2, rectH / 2, r);
            ctx.arcTo(-rectW / 2, rectH / 2, -rectW / 2, -rectH / 2, r);
            ctx.arcTo(-rectW / 2, -rectH / 2, rectW / 2, -rectH / 2, r);
          }
          ctx.fill();
          ctx.stroke();
          // Label
          ctx.fillStyle = '#0F0F10';
          ctx.font = '500 12px "DM Sans", system-ui';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(body.label, 0, 1);
          ctx.restore();
        });

        requestAnimationFrame(draw);
      };
      draw();
    })();

    // ─── PONG MINI-GAME (easter egg após Konami extra: "pong") ─────
    const pongOverlay = document.getElementById('pong-overlay');
    const pongCanvas = document.getElementById('pong-canvas') as HTMLCanvasElement | null;
    const pongClose = document.getElementById('pong-close');
    const pongScorePlayer = document.getElementById('pong-score-player');
    const pongScoreAi = document.getElementById('pong-score-ai');
    let pongActive = false;
    let pongAnim = 0;

    const startPong = () => {
      if (!pongOverlay || !pongCanvas) return;
      pongOverlay.classList.add('is-active');
      pongOverlay.setAttribute('aria-hidden', 'false');
      pongActive = true;
      const ctx = pongCanvas.getContext('2d');
      if (!ctx) return;

      const W = pongCanvas.width, H = pongCanvas.height;
      let playerY = H / 2;
      let aiY = H / 2;
      let ballX = W / 2, ballY = H / 2;
      let ballVx = 6, ballVy = 3;
      let scoreP = 0, scoreA = 0;
      const paddleH = 80, paddleW = 8;

      const onMove = (e: MouseEvent) => {
        const rect = pongCanvas.getBoundingClientRect();
        playerY = (e.clientY - rect.top) * (H / rect.height);
      };
      pongCanvas.addEventListener('mousemove', onMove);

      const reset = (dir: number) => {
        ballX = W / 2; ballY = H / 2;
        ballVx = 6 * dir; ballVy = (Math.random() - 0.5) * 6;
      };

      const tick = () => {
        if (!pongActive) return;
        // Update AI
        const aiTarget = ballVx > 0 ? ballY : H / 2;
        aiY += (aiTarget - aiY) * 0.06;

        // Update ball
        ballX += ballVx;
        ballY += ballVy;

        if (ballY < 0 || ballY > H) ballVy *= -1;

        // Player collision
        if (ballX < paddleW + 14 && Math.abs(ballY - playerY) < paddleH / 2) {
          ballVx = Math.abs(ballVx) * 1.05;
          ballVy += (ballY - playerY) * 0.1;
        }
        // AI collision
        if (ballX > W - paddleW - 14 && Math.abs(ballY - aiY) < paddleH / 2) {
          ballVx = -Math.abs(ballVx) * 1.05;
          ballVy += (ballY - aiY) * 0.1;
        }

        // Score
        if (ballX < 0) { scoreA++; reset(1); }
        if (ballX > W) { scoreP++; reset(-1); }

        if (pongScorePlayer) pongScorePlayer.textContent = String(scoreP);
        if (pongScoreAi) pongScoreAi.textContent = String(scoreA);

        // Draw
        ctx.fillStyle = '#0A0A0B';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
        ctx.fillRect(W / 2 - 1, 0, 2, H);
        ctx.fillStyle = '#5D4FA8';
        ctx.fillRect(10, playerY - paddleH / 2, paddleW, paddleH);
        ctx.fillRect(W - 10 - paddleW, aiY - paddleH / 2, paddleW, paddleH);
        ctx.fillStyle = '#fff';
        ctx.beginPath();
        ctx.arc(ballX, ballY, 6, 0, Math.PI * 2);
        ctx.fill();

        pongAnim = requestAnimationFrame(tick);
      };
      tick();
    };

    const stopPong = () => {
      pongActive = false;
      cancelAnimationFrame(pongAnim);
      pongOverlay?.classList.remove('is-active');
      pongOverlay?.setAttribute('aria-hidden', 'true');
    };

    pongClose?.addEventListener('click', stopPong);

    // Add "pong" to easter codes
    easterCodes['pong'] = startPong;
    easterCodes['game'] = startPong;

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && pongActive) stopPong();
    });

    // ─── THREE.JS PARTICLE FIELD (hero background) ─────────────
    (async () => {
      const heroCanvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
      const heroParent = document.querySelector('.hero') as HTMLElement | null;
      if (!heroCanvas || !heroParent) return;

      const THREE = await import('three');
      const renderer = new THREE.WebGLRenderer({
        canvas: heroCanvas,
        alpha: true,
        antialias: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
      camera.position.z = 6;

      // Floating particles
      const count = 280;
      const positions = new Float32Array(count * 3);
      const scales = new Float32Array(count);
      for (let i = 0; i < count; i++) {
        positions[i * 3]     = (Math.random() - 0.5) * 14;
        positions[i * 3 + 1] = (Math.random() - 0.5) * 9;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 8;
        scales[i] = Math.random() * 0.5 + 0.5;
      }
      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute('size', new THREE.BufferAttribute(scales, 1));

      const material = new THREE.PointsMaterial({
        size: 0.04,
        color: 0x5D4FA8,
        transparent: true,
        opacity: 0.55,
        sizeAttenuation: true,
        depthWrite: false,
      });
      const points = new THREE.Points(geometry, material);
      scene.add(points);

      // Subtle wireframe icosahedron
      const icoGeom = new THREE.IcosahedronGeometry(1.4, 1);
      const icoMat = new THREE.MeshBasicMaterial({
        color: 0x5D4FA8,
        wireframe: true,
        transparent: true,
        opacity: 0.1,
      });
      const ico = new THREE.Mesh(icoGeom, icoMat);
      ico.position.set(2.5, -0.5, 0);
      scene.add(ico);

      let mx3 = 0, my3 = 0;
      onMouseMove((e) => {
        mx3 = (e.clientX / window.innerWidth - 0.5) * 0.4;
        my3 = (e.clientY / window.innerHeight - 0.5) * -0.3;
      });

      const resize = () => {
        const w = heroParent.offsetWidth;
        const h = heroParent.offsetHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      window.addEventListener('resize', resize);

      const clockStart = performance.now();
      const heroVisible = observeVisibility(heroParent);
      const renderLoop = () => {
        if (!pageActive || !heroVisible.current) {
          requestAnimationFrame(renderLoop);
          return;
        }
        const t = (performance.now() - clockStart) / 1000;
        points.rotation.x = Math.sin(t * 0.05) * 0.15;
        points.rotation.y += 0.0008;
        points.rotation.y += (mx3 - points.rotation.y) * 0.01;

        ico.rotation.x = t * 0.12;
        ico.rotation.y = t * 0.08;
        ico.rotation.z = t * 0.05;
        ico.position.x = 2.5 + mx3 * 0.5;
        ico.position.y = -0.5 + my3 * 0.4;

        renderer.render(scene, camera);
        requestAnimationFrame(renderLoop);
      };
      renderLoop();
    })();
  </script>
</Layout>
