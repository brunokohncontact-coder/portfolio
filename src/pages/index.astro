    const setupDraggableMarquee = (marquee: HTMLElement, baseSpeed: number) => {
      const track = marquee.querySelector<HTMLElement>('.marquee-track');
      if (!track) return;
      let x = 0;
      let velocity = 0;
      let dragging = false;
      let startX = 0;
      let startTrackX = 0;
      let lastX = 0;
      let lastTime = 0;
      let trackHalfWidth = track.scrollWidth / 2;

      const recalc = () => { trackHalfWidth = track.scrollWidth / 2; };
      recalc();
      window.addEventListener('resize', recalc);

      const marqueeVisible = observeVisibility(marquee);
      const tick = () => {
        if (!pageActive || !marqueeVisible.current) {
          requestAnimationFrame(tick);
          return;
        }
        if (!dragging) {
          x += baseSpeed + velocity;
          velocity *= 0.93;
          if (Math.abs(velocity) < 0.01) velocity = 0;
        }
        // Wrap
        if (x <= -trackHalfWidth) x += trackHalfWidth;
        if (x > 0) x -= trackHalfWidth;
        track.style.transform = `translate3d(${x}px, 0, 0)`;
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      marquee.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        startX = e.clientX;
        startTrackX = x;
        lastX = e.clientX;
        lastTime = performance.now();
        velocity = 0;
        marquee.classList.add('is-grabbing');
        marquee.setPointerCapture(e.pointerId);
      });

      window.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        x = startTrackX + (e.clientX - startX);
        const now = performance.now();
        const dt = now - lastTime;
        if (dt > 0) velocity = (e.clientX - lastX) / dt * 16;
        lastX = e.clientX;
        lastTime = now;
      });

      const mEnd = () => {
        if (!dragging) return;
        dragging = false;
        marquee.classList.remove('is-grabbing');
      };
      window.addEventListener('pointerup', mEnd);
      window.addEventListener('pointercancel', mEnd);
    };

