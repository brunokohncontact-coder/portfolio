      rim.position.set(0, -3, -4);
      scene.add(rim);

      // Soft lavender material (no metalness = no flickering reflections)
      const mat = new THREE.MeshLambertMaterial({ color: 0xc8bce2 });

      const group = new THREE.Group();

      // ─── B letter: NON-overlapping pieces ──────────────────
      const bGroup = new THREE.Group();
      // Spine: full height, on the left
      const bSpine = new THREE.Mesh(new THREE.BoxGeometry(0.4, 2.6, 0.55), mat);
      bSpine.position.x = -0.5;
      bGroup.add(bSpine);
      // Top horizontal: starts right where spine ends
      const bTop = new THREE.Mesh(new THREE.BoxGeometry(0.85, 0.4, 0.55), mat);
      bTop.position.set(0.125, 1.1, 0);
      bGroup.add(bTop);
      // Middle horizontal
      const bMid = new THREE.Mesh(new THREE.BoxGeometry(0.85, 0.4, 0.55), mat);
      bMid.position.set(0.125, 0, 0);
      bGroup.add(bMid);
      // Bottom horizontal
      const bBot = new THREE.Mesh(new THREE.BoxGeometry(0.85, 0.4, 0.55), mat);
      bBot.position.set(0.125, -1.1, 0);
      bGroup.add(bBot);
      // Upper-right vertical (between top and mid)
      const bRight1 = new THREE.Mesh(new THREE.BoxGeometry(0.35, 0.7, 0.55), mat);
      bRight1.position.set(0.375, 0.55, 0);
      bGroup.add(bRight1);
      // Lower-right vertical (between mid and bot)
      const bRight2 = new THREE.Mesh(new THREE.BoxGeometry(0.35, 0.7, 0.55), mat);
      bRight2.position.set(0.375, -0.55, 0);
      bGroup.add(bRight2);
