  { val: '30 a 40', sup: '%', label: 'de redução no prazo de produção de materiais com automação', count: null },
  { val: '1', sup: 'ª',     label: 'plataforma EAD ambiental da cidade de São Paulo', count: null },
  { val: '~7', sup: '',     label: 'anos de experiência em comunicação institucional', count: null },
