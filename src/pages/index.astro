  <!-- ─── SCRIPTS ──────────────────────────────────────────────────────────── -->
  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // ─── FOCUS TRAP (dialog accessibility) ──────────────────
    // Mantém Tab/Shift+Tab dentro do dialog enquanto aberto.
    // Restaura foco no elemento que abriu o dialog ao fechar.
    const FOCUSABLE_SELECTOR = 'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';

    type TrapHandle = { release: () => void };
    const activeTraps = new Map<HTMLElement, TrapHandle>();

    const trapFocus = (root: HTMLElement): TrapHandle => {
      const previouslyFocused = document.activeElement as HTMLElement | null;

      const getFocusables = () =>
        Array.from(root.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR))
          .filter((el) => el.offsetParent !== null || el === root);

      const handleKey = (e: KeyboardEvent) => {
        if (e.key !== 'Tab') return;
        const focusables = getFocusables();
        if (focusables.length === 0) {
          e.preventDefault();
          root.focus();
          return;
        }
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const current = document.activeElement as HTMLElement | null;

        if (e.shiftKey) {
          if (current === first || !root.contains(current)) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (current === last || !root.contains(current)) {
            e.preventDefault();
            first.focus();
          }
        }
      };

      document.addEventListener('keydown', handleKey, true);

      requestAnimationFrame(() => {
        const focusables = getFocusables();
        (focusables[0] || root).focus({ preventScroll: true });
      });

      const handle: TrapHandle = {
        release: () => {
          document.removeEventListener('keydown', handleKey, true);
          if (previouslyFocused && document.body.contains(previouslyFocused)) {
            previouslyFocused.focus({ preventScroll: true });
          }
          activeTraps.delete(root);
        },
      };
      activeTraps.set(root, handle);
      return handle;
    };

    const releaseTrap = (root: HTMLElement) => {
      activeTraps.get(root)?.release();
    };

    // ─── MOUSEMOVE PUB/SUB ──────────────────────────────────
    // Um único listener global de mousemove. Cada feature registra um
    // callback via onMouseMove. Antes tinha 15+ listeners separados —
    // cada movimento do mouse disparava 15 callbacks com getBoundingClientRect.
    const mouseMoveSubscribers: Array<(e: MouseEvent) => void> = [];
    window.addEventListener('mousemove', (e: MouseEvent) => {
      for (let i = 0; i < mouseMoveSubscribers.length; i++) {
        mouseMoveSubscribers[i](e);
      }
    }, { passive: true });
    const onMouseMove = (cb: (e: MouseEvent) => void) => {
      mouseMoveSubscribers.push(cb);
    };

    // ─── ANIMATION GATING ───────────────────────────────────
    // Pausa RAF loops quando aba está em background OU quando a seção
    // que hospeda a animação está fora do viewport. Mata o uso de CPU/GPU
    // contínuo causado por dezenas de loops decorativos rodando em paralelo.
    let pageActive = !document.hidden;
    document.addEventListener('visibilitychange', () => {
      pageActive = !document.hidden;
    });

    // Cria um observador de viewport para um elemento. Cada loop pode
    // checar `visible.current` antes de processar o frame.
    const observeVisibility = (
      target: Element | null,
      options: IntersectionObserverInit = { threshold: 0, rootMargin: '200px' },
    ): { current: boolean } => {
      const state = { current: false };
      if (!target) { state.current = true; return state; }
      const io = new IntersectionObserver(([entry]) => {
        state.current = entry.isIntersecting;
      }, options);
      io.observe(target);
      return state;
    };

    // ─── LOADER ──────────────────────────────────────────────
    document.body.classList.add('loading');

    const loader = document.getElementById('loader');
    const counterEl = document.getElementById('loader-counter');
    const loadDuration = 1300;
    const loadStart = performance.now();

    const loadTick = (now: number) => {
      const elapsed = now - loadStart;
      const pct = Math.min(100, Math.round((elapsed / loadDuration) * 100));
      if (counterEl) counterEl.textContent = String(pct);
      if (pct < 100) {
        requestAnimationFrame(loadTick);
      } else {
        setTimeout(() => {
          loader?.classList.add('done');
          document.body.classList.remove('loading');
          document.body.classList.add('loaded');
          setTimeout(() => loader?.remove(), 1300);
        }, 180);
      }
    };
    requestAnimationFrame(loadTick);

    // ─── LENIS SMOOTH SCROLL + GSAP TICKER ─────────────────
    const lenis = new Lenis({
      duration: 1.15,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });

    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => { lenis.raf(time * 1000); });
    gsap.ticker.lagSmoothing(0);

    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const href = (a as HTMLAnchorElement).getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          lenis.scrollTo(target as HTMLElement, { offset: -40 });
        }
      });
    });

    // ─── NAV scroll state ────────────────────────────────────
    const nav = document.getElementById('main-nav');
    if (nav) {
      lenis.on('scroll', ({ scroll }: { scroll: number }) => {
        nav.classList.toggle('scrolled', scroll > 48);
      });
    }

    // ─── REVEAL on scroll ────────────────────────────────────
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal, .section-rule').forEach((el) => io.observe(el));

    // ─── NUMBER COUNTER ──────────────────────────────────────
    const counterIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.count || '0', 10);
            const duration = 1400;
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / duration);
              const eased = 1 - Math.pow(1 - t, 4);
              const val = Math.round(target * eased);
              el.textContent = val.toLocaleString('pt-BR');
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
            counterIO.unobserve(el);
          }
        });
      },
      { threshold: 0.4 }
    );
    document.querySelectorAll('[data-count]').forEach((el) => counterIO.observe(el));

    // ─── CUSTOM CURSOR ───────────────────────────────────────
    const cursor = document.getElementById('cursor');
    const cursorLabel = document.getElementById('cursor-label');
    let mx = 0, my = 0, cx = 0, cy = 0;

    const showCursor = () => cursor?.classList.remove('is-hidden');

    onMouseMove((e) => {
      mx = e.clientX;
      my = e.clientY;
      showCursor();
    });

    const cursorTick = () => {
      if (!pageActive) {
        requestAnimationFrame(cursorTick);
        return;
      }
      cx += (mx - cx) * 0.22;
      cy += (my - cy) * 0.22;
      if (cursor) cursor.style.transform = `translate(${cx}px, ${cy}px)`;
      requestAnimationFrame(cursorTick);
    };
    requestAnimationFrame(cursorTick);

    document.addEventListener('mouseleave', () => cursor?.classList.add('is-hidden'));
    document.addEventListener('mouseenter', () => showCursor());

    // Hover states (atualizado também para dom dinâmico via delegação)
    const hoverSelector = 'a, button, [data-cursor]';
    document.addEventListener('mouseover', (e) => {
      const target = (e.target as HTMLElement)?.closest(hoverSelector) as HTMLElement | null;
      if (!target || !cursor) return;
      const label = target.dataset.cursor;
      if (label) {
        cursor.classList.remove('is-hover');
        cursor.classList.add('is-text');
        if (cursorLabel) cursorLabel.textContent = label;
      } else {
        cursor.classList.remove('is-text');
        cursor.classList.add('is-hover');
      }
    });
    document.addEventListener('mouseout', (e) => {
      const target = (e.target as HTMLElement)?.closest(hoverSelector);
      if (!target || !cursor) return;
      cursor.classList.remove('is-hover', 'is-text');
      if (cursorLabel) cursorLabel.textContent = '';
    });

    // ─── MAGNETIC BUTTONS ────────────────────────────────────
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      const strength = 0.35;
      const radius = 100;
      onMouseMove((e) => {
        const rect = el.getBoundingClientRect();
        const cxEl = rect.left + rect.width / 2;
        const cyEl = rect.top + rect.height / 2;
        const dx = e.clientX - cxEl;
        const dy = e.clientY - cyEl;
        const d = Math.hypot(dx, dy);
        if (d < radius + Math.max(rect.width, rect.height) / 2) {
          el.style.transform = `translate(${dx * strength}px, ${dy * strength}px)`;
        } else {
          el.style.transform = '';
        }
      });
      el.addEventListener('mouseleave', () => { el.style.transform = ''; });
    });

    // ─── HERO MOUSE PARALLAX (unificado) ─────────────────────
    // Um único handler controla heroBk + heroMeta. No desktop adiciona
    // rotação 3D no monograma; no mobile apenas o translate suave.
    const heroBk = document.getElementById('hero-bk');
    const heroMeta = document.getElementById('hero-meta');
    const hero = document.querySelector('.hero');
    if (hero && heroBk) {
      const heroIsDesktop = window.matchMedia('(min-width: 769px)').matches;
      const heroEl = hero as HTMLElement;
      heroEl.addEventListener('mousemove', (e) => {
        const rect = heroEl.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        if (heroIsDesktop) {
          heroBk.style.transform =
            `perspective(1400px) rotateY(${x * 28}deg) rotateX(${y * -18}deg) translateZ(20px) translate(${x * -16}px, ${y * -10}px)`;
        } else {
          heroBk.style.transform = `translate(${x * -40}px, ${y * -25}px)`;
        }
        if (heroMeta) heroMeta.style.transform = `translate(${x * 14}px, ${y * 10}px)`;
      });
      heroEl.addEventListener('mouseleave', () => {
        heroBk.style.transform = '';
        if (heroMeta) heroMeta.style.transform = '';
      });
    }

    // ─── 3D TILT em [data-tilt] ─────────────────────────────
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      const img = el.querySelector('img, .projeto-panel-placeholder') as HTMLElement | null;
      const max = 8; // degrees
      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        el.style.transform = `perspective(1100px) rotateY(${x * max}deg) rotateX(${y * -max}deg)`;
        if (img) img.style.transform = `translateZ(40px) scale(1.04)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = '';
        if (img) img.style.transform = '';
      });
    });

    // ─── FULLSCREEN MENU ─────────────────────────────────────
    const menuTrigger = document.getElementById('menu-trigger');
    const menuOverlay = document.getElementById('menu-overlay');
    const menuTriggerLabel = document.getElementById('menu-trigger-label');
    const menuPreview = document.getElementById('menu-preview');
    const menuPreviewImg = document.getElementById('menu-preview-img') as HTMLImageElement | null;

    const openMenu = () => {
      if (!menuOverlay || !menuTrigger) return;
      menuOverlay.dataset.state = 'open';
      menuOverlay.setAttribute('aria-hidden', 'false');
      menuTrigger.setAttribute('aria-expanded', 'true');
      if (menuTriggerLabel) menuTriggerLabel.textContent = 'Fechar';
      document.body.classList.add('menu-open');
      lenis.stop();
      trapFocus(menuOverlay as HTMLElement);
    };

    const closeMenu = () => {
      if (!menuOverlay || !menuTrigger) return;
      menuOverlay.dataset.state = 'closing';
      menuTrigger.setAttribute('aria-expanded', 'false');
      if (menuTriggerLabel) menuTriggerLabel.textContent = 'Menu';
      releaseTrap(menuOverlay as HTMLElement);
      setTimeout(() => {
        if (menuOverlay) {
          menuOverlay.dataset.state = 'closed';
          menuOverlay.setAttribute('aria-hidden', 'true');
        }
        document.body.classList.remove('menu-open');
        lenis.start();
      }, 700);
    };

    if (menuTrigger) {
      menuTrigger.addEventListener('click', () => {
        const isOpen = menuTrigger.getAttribute('aria-expanded') === 'true';
        isOpen ? closeMenu() : openMenu();
      });
    }

    // Menu hover preview
    document.querySelectorAll<HTMLElement>('[data-menu-link]').forEach((link) => {
      link.addEventListener('mouseenter', () => {
        const src = link.dataset.preview;
        if (src && menuPreviewImg && menuPreview) {
          menuPreviewImg.src = src;
          menuPreview.classList.add('is-active');
        }
      });
      link.addEventListener('mouseleave', () => {
        menuPreview?.classList.remove('is-active');
      });
    });

    // ESC closes menu
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuTrigger?.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });

    // ─── CURTAIN PAGE TRANSITION (for menu/side-rail navigation) ──
    const curtain = document.getElementById('curtain');

    const curtainTransition = (target: HTMLElement) => {
      if (!curtain) {
        lenis.scrollTo(target, { offset: -40 });
        return;
      }
      curtain.dataset.state = 'enter';
      setTimeout(() => {
        lenis.scrollTo(target, { offset: -40, immediate: true });
        if (curtain) curtain.dataset.state = 'leave';
        setTimeout(() => {
          if (curtain) curtain.removeAttribute('data-state');
        }, 1000);
      }, 700);
    };

    // Apply curtain to menu links and side rail
    document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const target = document.querySelector(href) as HTMLElement | null;
        if (!target) return;
        e.preventDefault();
        e.stopPropagation();
        closeMenu();
        setTimeout(() => curtainTransition(target), 400);
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('.side-rail-link').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const target = document.querySelector(href) as HTMLElement | null;
        if (!target) return;
        e.preventDefault();
        e.stopPropagation();
        curtainTransition(target);
      });
    });

    // ─── SIDE RAIL: active state via scroll ──────────────────
    const railLinks = document.querySelectorAll<HTMLAnchorElement>('.side-rail-link');
    const sectionTargets = Array.from(railLinks)
      .map((l) => ({ link: l, el: document.getElementById(l.dataset.section || '') }))
      .filter((s) => s.el);

    const updateRail = () => {
      const y = window.scrollY + window.innerHeight * 0.35;
      let active = sectionTargets[0];
      for (const s of sectionTargets) {
        if (s.el && s.el.offsetTop <= y) active = s;
      }
      railLinks.forEach((l) => l.classList.remove('is-active'));
      active?.link.classList.add('is-active');
    };
    lenis.on('scroll', updateRail);
    updateRail();

    // ─── DARK THEME TRIGGER (Numeros section) ──────────────
    const darkSections = document.querySelectorAll<HTMLElement>('[data-theme="dark"]');
    darkSections.forEach((sec) => {
      ScrollTrigger.create({
        trigger: sec,
        start: 'top top+=80',
        end: 'bottom top+=80',
        onEnter: () => document.body.classList.add('theme-dark'),
        onLeave: () => document.body.classList.remove('theme-dark'),
        onEnterBack: () => document.body.classList.add('theme-dark'),
        onLeaveBack: () => document.body.classList.remove('theme-dark'),
      });
    });

    // Limpar inline body styles que podem ter ficado de uma versão anterior
    document.body.style.removeProperty('background-color');
    document.body.style.removeProperty('color');

    // ─── HORIZONTAL SCROLL PROJETOS ──────────────────────────
    const track = document.getElementById('projetos-track');
    const pin = document.getElementById('projetos-pin');
    const fill = document.getElementById('progress-fill');
    const currentEl = document.getElementById('progress-current');
    const total = document.querySelectorAll('.projeto-panel').length;
    const isDesktop = window.matchMedia('(min-width: 769px)').matches;

    if (track && pin && isDesktop) {
      const getDistance = () => track.scrollWidth - window.innerWidth + 80;

      gsap.to(track, {
        x: () => -getDistance(),
        ease: 'none',
        scrollTrigger: {
          trigger: pin,
          start: 'top top',
          end: () => `+=${getDistance()}`,
          pin: true,
          pinSpacing: true,
          scrub: 1.4,
          invalidateOnRefresh: true,
          anticipatePin: 1,
          fastScrollEnd: 800,
          refreshPriority: -1,
          onUpdate: (self) => {
            if (fill) fill.style.transform = `scaleX(${self.progress})`;
            if (currentEl) {
              const idx = Math.min(total, Math.max(1, Math.ceil(self.progress * total) || 1));
              currentEl.textContent = String(idx).padStart(2, '0');
            }
          },
        },
      });

      window.addEventListener('resize', () => ScrollTrigger.refresh());
    }

    // ─── TOP PROGRESS BAR ──────────────────────────────────────
    const progressLine = document.getElementById('progress-line');
    if (progressLine) {
      const updateProgress = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? window.scrollY / max : 0;
        progressLine.style.transform = `scaleX(${p})`;
      };
      lenis.on('scroll', updateProgress);
      updateProgress();
    }

    // ─── HERO BACKDROP HORIZONTAL PARALLAX ──────────────────
    const heroBackdrop = document.getElementById('hero-backdrop-text');
    const heroSection = document.querySelector('.hero') as HTMLElement | null;
    if (heroBackdrop && heroSection) {
      let lastY = 0;
      lenis.on('scroll', ({ scroll }: { scroll: number }) => {
        const heroH = heroSection.offsetHeight;
        if (scroll > heroH * 1.5) return;
        const tx = -scroll * 0.4;
        const scale = 1 - Math.min(0.08, scroll / heroH * 0.08);
        heroBackdrop.style.transform = `translateX(${tx}px) scale(${scale})`;
      });
    }

    // ─── HERO BK SCROLL CHOREOGRAPHY ────────────────────────
    const heroBkScroll = document.getElementById('hero-bk');
    if (heroBkScroll && heroSection) {
      lenis.on('scroll', ({ scroll }: { scroll: number }) => {
        const heroH = heroSection.offsetHeight;
        if (scroll > heroH) return;
        const p = scroll / heroH;
        const scale = 1 + p * 0.6;
        const ty = -p * 80;
        heroBkScroll.style.transform = `translate(0, ${ty}px) scale(${scale})`;
      });
    }

    // ─── SPOTLIGHT (dark section) ────────────────────────────
    document.querySelectorAll<HTMLElement>('.section--dark').forEach((sec) => {
      sec.addEventListener('mousemove', (e) => {
        const rect = sec.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        sec.style.setProperty('--mx', `${mx}px`);
        sec.style.setProperty('--my', `${my}px`);
      });
    });

    // ─── CURSOR TRAIL ────────────────────────────────────────
    const trailEls = Array.from(document.querySelectorAll<HTMLElement>('.cursor-trail'));
    const trails = trailEls.map((el) => ({ el, x: 0, y: 0 }));

    const trailTick = () => {
      if (!pageActive) {
        requestAnimationFrame(trailTick);
        return;
      }
      let px = mx, py = my;
      trails.forEach((t, i) => {
        const lerp = 0.32 - i * 0.035;
        t.x += (px - t.x) * lerp;
        t.y += (py - t.y) * lerp;
        t.el.style.transform = `translate(${t.x}px, ${t.y}px)`;
        px = t.x; py = t.y;
      });
      requestAnimationFrame(trailTick);
    };
    requestAnimationFrame(trailTick);

    // ─── DRAG-TO-SCROLL nos projetos ─────────────────────────
    const pinDrag = document.getElementById('projetos-pin');
    if (pinDrag && isDesktop) {
      let dragging = false;
      let startX = 0;
      let startScroll = 0;

      pinDrag.addEventListener('pointerdown', (e) => {
        if ((e.target as HTMLElement).closest('a, button')) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        startX = e.clientX;
        startScroll = lenis.scroll;
        pinDrag.classList.add('is-dragging');
        pinDrag.setPointerCapture(e.pointerId);
      });

      window.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        lenis.scrollTo(startScroll - dx * 2.4, { immediate: true });
      });

      const pinEnd = () => {
        if (dragging) {
          dragging = false;
          pinDrag.classList.remove('is-dragging');
        }
      };
      window.addEventListener('pointerup', pinEnd);
      window.addEventListener('pointercancel', pinEnd);
      window.addEventListener('mouseleave', () => {
        if (dragging) {
          dragging = false;
          pinDrag.classList.remove('is-dragging');
        }
      });
    }

    // ─── MENU TRIGGER LABEL: nome da seção atual ──────────────
    const menuLabel = document.getElementById('menu-trigger-label');
    const updateMenuLabel = () => {
      if (!menuLabel || menuTrigger?.getAttribute('aria-expanded') === 'true') return;
      const activeSection = sectionTargets.find(s => s.link.classList.contains('is-active'));
      if (activeSection) {
        const label = activeSection.link.querySelector('.side-rail-label')?.textContent?.trim().split(' ').slice(1).join(' ');
        menuLabel.textContent = label ? `Menu · ${label}` : 'Menu';
      } else {
        menuLabel.textContent = 'Menu';
      }
    };
    lenis.on('scroll', updateMenuLabel);

    // ─── KEYBOARD SHORTCUTS ──────────────────────────────────
    const helpOverlay = document.getElementById('help-overlay');
    const toggleHelp = () => {
      if (!helpOverlay) return;
      const willOpen = !helpOverlay.classList.contains('is-open');
      helpOverlay.classList.toggle('is-open');
      helpOverlay.setAttribute('aria-hidden', willOpen ? 'false' : 'true');
      if (willOpen) {
        trapFocus(helpOverlay as HTMLElement);
      } else {
        releaseTrap(helpOverlay as HTMLElement);
      }
    };
    const closeHelp = () => {
      if (!helpOverlay || !helpOverlay.classList.contains('is-open')) return;
      helpOverlay.classList.remove('is-open');
      helpOverlay.setAttribute('aria-hidden', 'true');
      releaseTrap(helpOverlay as HTMLElement);
    };

    window.addEventListener('keydown', (e) => {
      const tag = (document.activeElement?.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;

      switch (e.key.toLowerCase()) {
        case 'm': {
          e.preventDefault();
          const isOpen = menuTrigger?.getAttribute('aria-expanded') === 'true';
          isOpen ? closeMenu() : openMenu();
          break;
        }
        case 'p': {
          const el = document.getElementById('projetos');
          if (el) curtainTransition(el);
          break;
        }
        case 'c': {
          const el = document.getElementById('contato');
          if (el) curtainTransition(el);
          break;
        }
        case 't': {
          lenis.scrollTo(0);
          break;
        }
        case '?':
        case '/': {
          e.preventDefault();
          toggleHelp();
          break;
        }
        case 'escape': {
          closeHelp();
          break;
        }
      }
    });

    helpOverlay?.addEventListener('click', (e) => {
      if (e.target === helpOverlay) closeHelp();
    });

    // 3D BK MONOGRAM agora vive dentro do handler unificado de "HERO MOUSE PARALLAX" acima.

    // ─── PHYSICS ZONE: visibility-based overlay fade ─────────
    const physicsSec = document.getElementById('physics');
    if (physicsSec) {
      const physObs = new IntersectionObserver(
        ([entry]) => physicsSec.classList.toggle('is-visible', entry.isIntersecting),
        { threshold: 0.2 }
      );
      physObs.observe(physicsSec);
    }

    // ─── AUDIO (Web Audio API) ─────────────────────────────────
    let audioCtx: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let ambientNodes: { stop: () => void } | null = null;
    let audioOn = false;

    const initAudio = () => {
      const win = window as Window & { webkitAudioContext?: typeof AudioContext };
      const Ctx = win.AudioContext || win.webkitAudioContext;
      if (!Ctx) return;
      audioCtx = new Ctx();
      masterGain = audioCtx.createGain();
      masterGain.gain.value = 0.45;
      masterGain.connect(audioCtx.destination);
    };

    let panner: StereoPannerNode | null = null;

    const startAmbient = () => {
      if (!audioCtx || !masterGain) return;

      // Stereo panner for spatial audio
      panner = audioCtx.createStereoPanner();
      panner.connect(masterGain);

      // Feedback delay reverb
      const delay = audioCtx.createDelay(2);
      delay.delayTime.value = 0.45;
      const feedback = audioCtx.createGain();
      feedback.gain.value = 0.42;
      const reverbFilter = audioCtx.createBiquadFilter();
      reverbFilter.type = 'lowpass';
      reverbFilter.frequency.value = 1400;
      delay.connect(reverbFilter);
      reverbFilter.connect(feedback);
      feedback.connect(delay);
      const wet = audioCtx.createGain();
      wet.gain.value = 0.35;
      delay.connect(wet);
      wet.connect(panner);

      // Chord progression: Am - F - C - G (in low octave)
      const chords = [
        [110, 130.81, 164.81],          // Am: A2, C3, E3
        [87.31, 130.81, 174.61],        // F: F2, C3, F3
        [130.81, 164.81, 196.00],       // C: C3, E3, G3
        [98.00, 123.47, 146.83],        // G: G2, B2, D3
      ];
      const pentatonic = [261.63, 293.66, 329.63, 392.00, 440.00, 523.25];

      let chordIdx = 0;
      let active: OscillatorNode[] = [];
      let chordTimer: number;
      let melodyTimer: number;

      const playChord = () => {
        if (!audioCtx || !panner) return;
        const notes = chords[chordIdx];
        const now = audioCtx.currentTime;
        const dur = 9;

        active.forEach(o => { try { o.stop(now + 1.5); } catch {} });
        active = [];

        notes.forEach((freq) => {
          const osc = audioCtx!.createOscillator();
          const oscGain = audioCtx!.createGain();
          osc.type = 'sine';
          osc.frequency.value = freq;
          osc.detune.value = (Math.random() - 0.5) * 6;

          oscGain.gain.setValueAtTime(0, now);
          oscGain.gain.linearRampToValueAtTime(0.22 / notes.length, now + 2.5);
          oscGain.gain.linearRampToValueAtTime(0.18 / notes.length, now + dur - 2);
          oscGain.gain.linearRampToValueAtTime(0, now + dur);

          osc.connect(oscGain);
          oscGain.connect(panner!);
          oscGain.connect(delay);

          osc.start(now);
          osc.stop(now + dur);
          active.push(osc);
        });

        chordIdx = (chordIdx + 1) % chords.length;
        chordTimer = window.setTimeout(playChord, (dur - 1.5) * 1000);
      };

      const playMelodyNote = () => {
        if (!audioCtx || !panner) return;
        if (Math.random() > 0.45) {
          const freq = pentatonic[Math.floor(Math.random() * pentatonic.length)];
          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const mGain = audioCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.value = freq;
          const dur = 1.5 + Math.random() * 2.5;
          mGain.gain.setValueAtTime(0, now);
          mGain.gain.linearRampToValueAtTime(0.10, now + 0.08);
          mGain.gain.exponentialRampToValueAtTime(0.001, now + dur);
          osc.connect(mGain);
          mGain.connect(panner);
          mGain.connect(delay);
          osc.start(now);
          osc.stop(now + dur);
        }
        melodyTimer = window.setTimeout(playMelodyNote, 1800 + Math.random() * 3500);
      };

      playChord();
      melodyTimer = window.setTimeout(playMelodyNote, 3000);

      return {
        stop: () => {
          clearTimeout(chordTimer);
          clearTimeout(melodyTimer);
          const now = audioCtx!.currentTime;
          active.forEach(o => { try { o.stop(now + 0.8); } catch {} });
        },
      };
    };

    // Spatial audio: mouse position controls pan
    onMouseMove((e) => {
      if (panner && audioOn) {
        const x = (e.clientX / window.innerWidth) * 2 - 1;
        panner.pan.setTargetAtTime(x * 0.7, audioCtx!.currentTime, 0.1);
      }
    });

    const playTone = (freq: number, duration = 0.12, type: OscillatorType = 'sine') => {
      if (!audioOn || !audioCtx || !masterGain) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      const now = audioCtx.currentTime;
      gain.gain.setValueAtTime(0, now);
      gain.gain.linearRampToValueAtTime(0.18, now + 0.005);
      gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
      osc.connect(gain);
      gain.connect(masterGain);
      osc.start(now);
      osc.stop(now + duration);
    };

    const audioBtn = document.getElementById('audio-toggle');
    const audioIcon = document.getElementById('audio-icon');

    audioBtn?.addEventListener('click', async () => {
      if (!audioCtx) initAudio();
      if (audioCtx?.state === 'suspended') await audioCtx.resume();
      audioOn = !audioOn;
      audioBtn.setAttribute('aria-pressed', String(audioOn));
      if (audioOn) {
        ambientNodes = startAmbient() || null;
        playTone(880, 0.18);
        if (audioIcon) audioIcon.style.color = 'var(--color-accent)';
      } else {
        ambientNodes?.stop();
        ambientNodes = null;
        playTone(440, 0.18);
        if (audioIcon) audioIcon.style.color = '';
      }
    });

    // Hover sons em links principais
    const noteScale = [523.25, 587.33, 659.25, 698.46, 783.99, 880, 987.77];
    let noteIdx = 0;
    document.querySelectorAll('a.menu-item, a.projeto-panel-cta, a.btn-primary').forEach((el) => {
      el.addEventListener('mouseenter', () => {
        playTone(noteScale[noteIdx % noteScale.length], 0.08);
        noteIdx++;
      });
    });

    // ─── KONAMI CODE (party mode) ──────────────────────────────
    const konami = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let konamiIdx = 0;
    const partyToast = document.getElementById('party-toast');

    const activateParty = () => {
      document.body.classList.add('party');
      if (partyToast) {
        partyToast.classList.add('is-visible');
        setTimeout(() => partyToast.classList.remove('is-visible'), 3500);
      }
      // Cycle party hue continuously
      let hue = 270;
      const cycle = () => {
        hue = (hue + 0.3) % 360;
        document.documentElement.style.setProperty('--party-hue', String(hue));
        if (document.body.classList.contains('party')) requestAnimationFrame(cycle);
      };
      requestAnimationFrame(cycle);
    };

    const deactivateParty = () => {
      document.body.classList.remove('party');
      document.documentElement.style.removeProperty('--party-hue');
    };

    window.addEventListener('keydown', (e) => {
      const expected = konami[konamiIdx];
      if (e.key === expected || e.key.toLowerCase() === expected.toLowerCase()) {
        konamiIdx++;
        if (konamiIdx === konami.length) {
          activateParty();
          konamiIdx = 0;
        }
      } else {
        konamiIdx = 0;
      }
      if (e.key.toLowerCase() === 'x' && document.body.classList.contains('party')) {
        deactivateParty();
      }
    });

    // ─── TEXT SCRAMBLE on hover ────────────────────────────────
    const scrambleChars = '!<>-_\\/[]{}—=+*^?#________';

    type ScrambleStep = { from: string; to: string; start: number; end: number; char: string };

    class Scrambler {
      el: HTMLElement;
      original: string;
      queue: ScrambleStep[] = [];
      frame = 0;
      frameRequest = 0;
      running = false;

      constructor(el: HTMLElement) {
        this.el = el;
        this.original = el.textContent || '';
      }

      run() {
        if (this.running) return;
        this.running = true;
        const text = this.original;
        const length = text.length;
        this.queue = [];
        for (let i = 0; i < length; i++) {
          const from = text[i];
          const to = text[i];
          const start = Math.floor(Math.random() * 20);
          const end = start + Math.floor(Math.random() * 20);
          this.queue.push({ from, to, start, end, char: '' });
        }
        cancelAnimationFrame(this.frameRequest);
        this.frame = 0;
        this.update();
      }

      update() {
        let output = '';
        let complete = 0;
        for (let i = 0, n = this.queue.length; i < n; i++) {
          let { from, to, start, end, char } = this.queue[i];
          if (this.frame >= end) {
            complete++;
            output += to;
          } else if (this.frame >= start) {
            if (!char || Math.random() < 0.28) {
              char = scrambleChars[Math.floor(Math.random() * scrambleChars.length)];
              this.queue[i].char = char;
            }
            output += `<span class="scramble-dud">${char}</span>`;
          } else {
            output += from;
          }
        }
        this.el.innerHTML = output;
        if (complete === this.queue.length) {
          this.running = false;
          this.el.textContent = this.original;
        } else {
          this.frame++;
          this.frameRequest = requestAnimationFrame(() => this.update());
        }
      }
    }

