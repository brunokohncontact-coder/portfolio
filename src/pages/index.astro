    tags: ['Estratégia', 'Identidade Visual', 'Editorial'],
    img: '/assets/02_plano_comunicacao/Img_1_Coautoria_Plano_de_Comunicacao.jpg',
    href: '/projetos/plano-de-comunicacao-umapaz',
  },
  {
    num: '03',
    year: '2020 / 2024',
    title: 'Instagram UMAPAZ',
    desc: 'Liderança da estratégia digital, planejamento editorial e análise de métricas em equipe de três estagiários. O perfil saiu de 5 mil para 20 mil seguidores ao longo de quatro anos, com identidade visual consolidada na grade.',
    tags: ['Social Media', 'Estratégia', 'Gestão de Equipe'],
    img: '/assets/03_instagram/Screenshot_20240225-185153.png',
    href: '/projetos/instagram-umapaz',
  },
  {
    num: '04',
    year: 'Contínuo',
    title: 'Motion Design e Vídeo',
    desc: 'Trabalho contínuo com motion graphics, edição e direção. Animações para Facebook, Eudora e ArtPlan na passagem pela OCTO Studio, e produção institucional na UMAPAZ e na Tetra Mais. Reels disponíveis no Vimeo.',
    tags: ['After Effects', 'Premiere', 'Direção Audiovisual'],
    img: '/assets/04_motion_video/capa-motion-reel.jpg',
    href: '/projetos/motion-design',
  },
  {
    num: '05',
