  {
    num: '03',
    eyebrow: 'Como',
    title: 'Estrutura de equipe',
    desc: 'A equipe de estagiários me permitiu desenvolver simultaneamente a primeira plataforma de educação ambiental a distância da cidade, co-escrever o Plano de Comunicação institucional e participar do crescimento do Instagram, que saiu de 5 mil para 20 mil seguidores.',
    stats: [{ val: '3', label: 'estagiários' }, { val: '4', label: 'anos liderando' }],
  },
  {
    num: '04',
    eyebrow: 'Hoje',
    title: 'Tetra Mais, consultoria ambiental',
    desc: 'Atuo como analista pleno na Tetra Mais, consultoria que dá suporte a processos de licenciamento. Continuo aprofundando diagramação técnica, produção audiovisual e automação de fluxos de comunicação com IA.',
    stats: [{ val: '1', label: 'ano atual' }, { val: '+', label: 'aprofundando' }],
  },
  {
    num: '05',
    eyebrow: 'Para onde',
    title: 'Oportunidades com sentido',
    desc: 'Busco oportunidades remotas em organizações comprometidas com sustentabilidade, equidade econômica e justiça social. Comunicação que serve a causas reais.',
    stats: [{ val: '🌍', label: 'remoto' }, { val: '✦', label: 'impacto social' }],
