const sobreChapters = [
  {
    num: '01',
    eyebrow: 'Quem',
    title: 'Bruno Rossi Kohn',
    desc: 'Analista de comunicação e designer multimídia baseado em São Paulo. Trabalho na interseção entre estratégia, design e tecnologia, buscando aplicar essas três frentes em causas com impacto social real.',
